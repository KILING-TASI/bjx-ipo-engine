            "evidence": {
              "basis": "assumption",
              "source": "教学现金计划"
            }
          },
          {
            "id": "A-refund",
            "instrument": "DEMO-A",
            "date": "2026-10-14",
            "kind": "refund",
            "amount": 800,
            "evidence": {
              "basis": "assumption",
              "source": "教学现金计划"
            }
          },
          {
            "id": "A-sale",
            "instrument": "DEMO-A",
            "date": "2026-10-20",
            "kind": "sale",
            "amount": 250,
            "principal_released": 200,
            "evidence": {
              "basis": "assumption",
              "source": "教学现金计划，amount为扣除卖出费用后现金净回款"
            }
          }
        ]
      },
      "expected": {
        "executable": true,
        "final_available_cash_exact": "1050",
        "outstanding_ipo_principal": 0
      },
      "expected_exit": 0,
      "basis": "1000-1000+800+250=1050; retained200 released on sale",
      "sample_kind": "teaching"
    },
