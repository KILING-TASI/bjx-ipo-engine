          "trading_dates": [
            "2026-10-12",
            "2026-10-13",
            "2026-10-14",
            "2026-10-15",
            "2026-10-16",
            "2026-10-19",
            "2026-10-20"
          ]
        },
        "events": [
          {
            "id": "A-freeze",
            "instrument": "DEMO-A",
            "date": "2026-10-12",
            "kind": "freeze",
