    {
      "id": "below-second-lot",
      "mode": "scenarios",
      "input": {
        "capital": 10000000,
        "budget": 3599,
        "issue_price": 18,
        "max_subscription_shares": 600000,
        "subscription_date": "2026-10-12",
        "refund_available_date": "2026-10-14",
        "sale_cash_available_date": "2026-10-20",
        "annual_cash_cost_rate": 0.02,
        "fees": {
          "commission_rate": 0.00025,
          "minimum_commission": 5,
          "stamp_rate": 0.0005,
          "transfer_rate": 1e-05
        },
        "scenarios": [
          {
            "id": "declared",
            "allocation_rate": 1,
            "listing_return": 0,
            "basis": "Teaching only; not a forecast"
          }
        ]
      },
      "expected": {
        "subscribed_shares": 100,
        "frozen_amount": 1800
      },
      "expected_exit": 0,
      "basis": "floor(3599/18/100)*100=100; freeze100*18",
      "sample_kind": "teaching"
    },
